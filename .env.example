# =====================================================================
# KNB Detailing — environment variables
# Copy to .env.local for development; set in Vercel project settings
# for production. NEVER commit .env.local or real keys.
# Detailed acquisition steps for each value: see DEPLOYMENT.md.
# =====================================================================

# --- Site (required) -------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required, Phase 2) ------------------------------------
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used by Supabase CLI; not strictly required at runtime
SUPABASE_PROJECT_REF=

# --- Stripe (required, Phase 6) --------------------------------------
# Dashboard → Developers → API keys (use TEST keys for dev)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Created when you add the webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=
# Created by scripts/stripe-setup.ts after products/prices are provisioned
STRIPE_PRICE_MEMBERSHIP_EXPRESS=
STRIPE_PRICE_MEMBERSHIP_LAKELIFE=
STRIPE_PRICE_MEMBERSHIP_PREMIUM=
STRIPE_PRICE_MEMBERSHIP_CAPTAINS=

# --- Resend (required, Phase 7) --------------------------------------
# Dashboard → API Keys
RESEND_API_KEY=
# Verified sender — must be on a domain you control
RESEND_FROM_EMAIL="KNB Detailing <hello@knbdetailing.com>"
# Where to send owner notifications (new bookings, leads, etc.)
OWNER_NOTIFICATION_EMAIL=

# --- Twilio (required for SMS, Phase 7) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sentry (optional, Phase 8) --------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Analytics (optional) --------------------------------------------
# Gate scripts on presence; never render them when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Cron / internal calls (Phase 7 reminders) -----------------------
# Random 32+ char string; matched against the `Authorization: Bearer ...`
# header on cron-triggered route handlers.
CRON_SECRET=
